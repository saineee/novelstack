<mxfile host="app.diagrams.net">
  <diagram id="novelstack" name="Architecture">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="novelstack: architecture and deploy pipeline" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="One Fargate task with a public IP, no load balancer and no NAT gateway, to keep it cheap. The database has no public IP and only accepts the app's security group." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="45" width="1160" height="30" as="geometry" />
        </mxCell>

        <!-- Groups -->
        <mxCell id="g_cloud" value="AWS Cloud (us-east-1)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="900" height="440" as="geometry" />
        </mxCell>
        <mxCell id="g_vpc" value="VPC" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="560" height="360" as="geometry" />
        </mxCell>
        <mxCell id="g_public" value="Public subnet" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="260" height="280" as="geometry" />
        </mxCell>

        <!-- Runtime -->
        <mxCell id="users" value="Users&lt;br&gt;(browser)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="igw" value="Internet&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1">
          <mxGeometry x="306" y="306" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="task" value="App task (ECS Fargate)&lt;br&gt;Gunicorn + Django + WhiteNoise&lt;br&gt;public IP, port 8000&lt;br&gt;runs migrate on every start" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="460" y="300" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rds" value="RDS PostgreSQL&lt;br&gt;no public IP&lt;br&gt;SG: only from the app's SG" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value="ECR&lt;br&gt;novelstack:&amp;lt;git sha&amp;gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
          <mxGeometry x="1000" y="190" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ecs" value="ECS service&lt;br&gt;novelstack-service&lt;br&gt;(task definition holds&lt;br&gt;config and secrets as env vars)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;" vertex="1" parent="1">
          <mxGeometry x="1000" y="360" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="anilist" value="AniList GraphQL API&lt;br&gt;(book data for imports)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#02A9FF;strokeWidth=2;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1260" y="300" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_users_task" value="HTTP 8000 to the task's&lt;br&gt;public IP (no load balancer,&lt;br&gt;no HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#232F3E;" edge="1" parent="1" source="users" target="task">
          <mxGeometry x="-0.4" relative="1" as="geometry">
            <mxPoint as="offset" y="-25" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_task_rds" value="Postgres 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#C925D1;" edge="1" parent="1" source="task" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_task_anilist" value="HTTPS GraphQL, staff imports only&lt;br&gt;out through the internet gateway (no NAT needed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#02A9FF;exitX=0.5;exitY=0;" edge="1" parent="1" source="task" target="anilist">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="125" />
              <mxPoint x="1350" y="125" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_ecr_task" value="image pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#ED7100;dashed=1;" edge="1" parent="1" source="ecr" target="task">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="270" />
              <mxPoint x="540" y="270" />
              <mxPoint x="540" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_ecs_task" value="runs and replaces&lt;br&gt;the task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#ED7100;dashed=1;" edge="1" parent="1" source="ecs" target="task">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="455" />
              <mxPoint x="490" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- CI/CD -->
        <mxCell id="g_gh" value="GitHub Actions: pipeline.yml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F8F8;strokeColor=#24292F;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1160" height="330" as="geometry" />
        </mxCell>

        <mxCell id="pr_t" value="Pull request to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pr_test" value="&lt;b&gt;test job&lt;/b&gt;&lt;br&gt;Tailwind build, collectstatic,&lt;br&gt;pytest against a postgres:15&lt;br&gt;service container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="640" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pr_stop" value="stops here&lt;br&gt;(the AWS trust policy only accepts main,&lt;br&gt;so a PR can't reach AWS at all)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;dashed=1;fontSize=11;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="main_t" value="Push to main&lt;br&gt;(a merged PR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="main_test" value="&lt;b&gt;test job&lt;/b&gt;&lt;br&gt;(same as on a PR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="790" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="main_deploy" value="&lt;b&gt;deploy job&lt;/b&gt; (needs: test)&lt;br&gt;OIDC: GitHub token traded&lt;br&gt;for 1-hour AWS credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="790" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="role" value="&lt;b&gt;IAM role GHAuthForNovelstack&lt;/b&gt;&lt;br&gt;trusts: this repo, main only&lt;br&gt;can: push to this ECR repo,&lt;br&gt;update this ECS service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="790" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="steps" value="1. build, push novelstack:&amp;lt;sha&amp;gt;&lt;br&gt;2. render the task definition&lt;br&gt;with the new image&lt;br&gt;3. deploy, wait for stability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="780" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c1" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="pr_t" target="pr_test"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="html=1;endArrow=block;endFill=1;strokeColor=#AAB7B8;dashed=1;" edge="1" parent="1" source="pr_test" target="pr_stop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="main_t" target="main_test"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" value="on pass" style="html=1;endArrow=block;endFill=1;strokeColor=#147EBA;fontSize=10;" edge="1" parent="1" source="main_test" target="main_deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" value="OIDC" style="html=1;endArrow=block;endFill=1;strokeColor=#DD344C;fontSize=10;" edge="1" parent="1" source="main_deploy" target="role"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" style="html=1;endArrow=block;endFill=1;strokeColor=#ED7100;" edge="1" parent="1" source="role" target="steps"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" value="push image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;dashed=1;fontSize=10;exitX=1;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="steps" target="ecr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1230" y="802" />
              <mxPoint x="1230" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c8" value="new revision,&lt;br&gt;update service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;dashed=1;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="steps" target="ecs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
